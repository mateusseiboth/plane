// Prisma schema — Plane TypeScript API (full parity + premium features)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Instance {
  id                    String    @id @default(uuid()) @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  instanceName          String    @default("Plane") @map("instance_name")
  instanceId            String    @unique @map("instance_id")
  currentVersion        String    @default("0.23-dev") @map("current_version")
  latestVersion         String?   @map("latest_version")
  edition               String    @default("PLANE_COMMUNITY")
  domain                String    @default("")
  isSetupDone           Boolean   @default(false) @map("is_setup_done")
  isSignupScreenVisited Boolean   @default(false) @map("is_signup_screen_visited")
  isTelemetryEnabled    Boolean   @default(true) @map("is_telemetry_enabled")
  isSupportRequired     Boolean   @default(true) @map("is_support_required")
  lastCheckedAt         DateTime  @default(now()) @map("last_checked_at")
  configurations        Json?     @map("configurations")
  @@map("instances")
}

model User {
  id                String    @id @default(uuid()) @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")
  email             String    @unique
  username          String?   @unique
  firstName         String    @default("") @map("first_name")
  lastName          String    @default("") @map("last_name")
  displayName       String    @default("") @map("display_name")
  avatar            String    @default("")
  avatarUrl         String?   @map("avatar_url")
  dateJoined        DateTime  @default(now()) @map("date_joined")
  isActive          Boolean   @default(true) @map("is_active")
  isStaff           Boolean   @default(false) @map("is_staff")
  isSuperuser       Boolean   @default(false) @map("is_superuser")
  isInstanceAdmin   Boolean   @default(false) @map("is_instance_admin")
  isBotUser         Boolean   @default(false) @map("is_bot_user")
  userTimezone      String    @default("UTC") @map("user_timezone")
  language          String    @default("en") @db.VarChar(20)
  weekStartDay      Int       @default(0) @map("week_start_day")
  metadata          Json      @default("{}")
  lastLoginMedium   String    @default("email") @map("last_login_medium")
  isPasswordAutoset Boolean   @default(false) @map("is_password_autoset")
  isEmailVerified   Boolean   @default(false) @map("is_email_verified")
  password          String?   @map("password")
  tokenUpdatedAt    DateTime? @map("token_updated_at")
  apiTokens                ApiToken[]
  workspaceMembers         WorkspaceMember[]
  projectMembers           ProjectMember[]
  createdIssues            Issue[]                   @relation("IssueCreatedBy")
  updatedIssues            Issue[]                   @relation("IssueUpdatedBy")
  issueAssignees           IssueAssignee[]
  issueComments            IssueComment[]            @relation("CommentActor")
  issueReactions           IssueReaction[]           @relation("IssueReactionActor")
  commentReactions         CommentReaction[]         @relation("CommentReactionActor")
  issueSubscriptions       IssueSubscriber[]         @relation("IssueSubscriberUser")
  issueVotes               IssueVote[]               @relation("IssueVoteActor")
  issueMentions            IssueMention[]            @relation("IssueMentionUser")
  createdCycles            Cycle[]
  cycleUserProperties      CycleUserProperties[]     @relation("CycleUserPropsUser")
  createdModules           Module[]
  moduleMembers            ModuleMember[]            @relation("ModuleMemberUser")
  ownedPages               Page[]
  entitiesCreated          Entity[]                  @relation("EntityCreatedBy")
  technicalVisitsPrimary   TechnicalVisit[]          @relation("VisitTechnicianPrimary")
  technicalVisitsSecondary TechnicalVisit[]          @relation("VisitTechnicianSecondary")
  notificationsReceived    Notification[]            @relation("NotificationReceiver")
  notificationsActed       Notification[]            @relation("NotificationActor")
  notificationPreferences  UserNotificationPreference[]
  userFavorites            UserFavorite[]
  recentVisits             UserRecentVisit[]
  stickies                 Sticky[]                  @relation("StickyOwner")
  timeLogs                 IssueTimeLog[]            @relation("TimeLogMember")
  workspaceUserProperties  WorkspaceUserProperties[] @relation("WorkspaceUserPropsUser")
  projectUserProperties    ProjectUserProperty[]     @relation("ProjectUserPropsUser")
  @@map("users")
}

model ApiToken {
  id          String    @id @default(uuid()) @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String    @map("user_id") @db.Uuid
  label       String    @default("")
  token       String    @unique
  isActive    Boolean   @default(true) @map("is_active")
  expiredAt   DateTime? @map("expired_at")
  lastUsed    DateTime? @map("last_used")
  description String    @default("")
  userType    Int       @default(0) @map("user_type")
  activityLogs ApiActivityLog[]
  @@map("api_tokens")
}

model ApiActivityLog {
  id          String    @id @default(uuid()) @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  token       ApiToken  @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  tokenId     String    @map("token_id") @db.Uuid
  workspaceId String?   @map("workspace_id") @db.Uuid
  projectId   String?   @map("project_id") @db.Uuid
  method      String
  path        String
  ipAddress   String?   @map("ip_address")
  userAgent   String?   @map("user_agent")
  statusCode  Int       @map("status_code")
  @@map("api_activity_logs")
}

model Workspace {
  id          String    @id @default(uuid()) @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  name        String
  slug        String    @unique
  logo        String?
  logoUrl     String?   @map("logo_url")
  orgSize     String?   @map("org_size")
  timezone    String    @default("UTC")
  members               WorkspaceMember[]
  memberInvites         WorkspaceMemberInvite[]
  projects              Project[]
  labels                Label[]
  pages                 Page[]
  entities              Entity[]
  technicalVisits       TechnicalVisit[]
  webhooks              Webhook[]
  analyticViews         AnalyticView[]
  deployBoards          DeployBoard[]
  notifications         Notification[]
  notificationPrefs     UserNotificationPreference[]
  userFavorites         UserFavorite[]
  recentVisits          UserRecentVisit[]
  stickies              Sticky[]
  issueViews            IssueView[]
  gitConfigs            GitIntegrationConfig[]
  slackConfig           SlackIntegrationConfig?
  settings              WorkspaceSetting[]
  estimates             Estimate[]
  aiProviders           AiProvider[]
  importJobs            ImportJob[]
  exportJobs            ExportJob[]
  workspaceUserProps    WorkspaceUserProperties[]
  projectUserProps      ProjectUserProperty[]
  @@map("workspaces")
}

model WorkspaceMember {
  id          String    @id @default(uuid()) @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String    @map("workspace_id") @db.Uuid
  member      User      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId    String    @map("member_id") @db.Uuid
  role        Int       @default(5)
  isActive    Boolean   @default(true) @map("is_active")
  companyRole String?   @map("company_role")
  @@unique([workspaceId, memberId, deletedAt])
  @@map("workspace_members")
}

model WorkspaceMemberInvite {
  id          String    @id @default(uuid()) @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String    @map("workspace_id") @db.Uuid
  email       String
  accepted    Boolean   @default(false)
  token       String    @unique
  message     String?
  respondedAt DateTime? @map("responded_at")
  role        Int       @default(5)
  @@map("workspace_member_invites")
}

model Project {
  id                    String    @id @default(uuid()) @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  deletedAt             DateTime? @map("deleted_at")
  createdById           String?   @map("created_by_id") @db.Uuid
  updatedById           String?   @map("updated_by_id") @db.Uuid
  workspace             Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId           String    @map("workspace_id") @db.Uuid
  name                  String
  identifier            String
  description           String    @default("")
  network               Int       @default(2)
  defaultAssigneeId     String?   @map("default_assignee_id") @db.Uuid
  projectLeadId         String?   @map("project_lead_id") @db.Uuid
  emoji                 String?
  iconProp              Json?     @map("icon_prop")
  coverImage            String?   @map("cover_image")
  moduleView            Boolean   @default(false) @map("module_view")
  cycleView             Boolean   @default(false) @map("cycle_view")
  issueViewsView        Boolean   @default(false) @map("issue_views_view")
  pageView              Boolean   @default(true) @map("page_view")
  intakeView            Boolean   @default(false) @map("intake_view")
  isTimeTrackingEnabled Boolean   @default(false) @map("is_time_tracking_enabled")
  isIssueTypeEnabled    Boolean   @default(false) @map("is_issue_type_enabled")
  estimateId            String?   @map("estimate_id") @db.Uuid
  archiveIn             Int       @default(0) @map("archive_in")
  closeIn               Int       @default(0) @map("close_in")
  defaultStateId        String?   @map("default_state_id") @db.Uuid
  timezone              String?
  externalSource        String?   @map("external_source")
  externalId            String?   @map("external_id")
  archivedAt            DateTime? @map("archived_at")
  members               ProjectMember[]
  memberInvites         ProjectMemberInvite[]
  issues                Issue[]
  draftIssues           DraftIssue[]
  states                State[]
  cycles                Cycle[]
  modules               Module[]
  pages                 ProjectPage[]
  labels                Label[]
  estimates             Estimate[]
  intakes               Intake[]
  issueViews            IssueView[]
  notifications         Notification[]
  userProperties        ProjectUserProperty[]
  gitRepositories       GitRepository[]
  slackChannels         SlackProjectChannel[]
  importJobs            ImportJob[]
  deployBoards          DeployBoard[]
  @@unique([workspaceId, identifier, deletedAt])
  @@unique([workspaceId, name, deletedAt])
  @@map("projects")
}

model ProjectMember {
  id          String    @id @default(uuid()) @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String    @map("project_id") @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  member      User      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId    String    @map("member_id") @db.Uuid
  role        Int       @default(5)
  isActive    Boolean   @default(true) @map("is_active")
  @@unique([projectId, memberId, deletedAt])
  @@map("project_members")
}

model ProjectMemberInvite {
  id          String    @id @default(uuid()) @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String    @map("project_id") @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  invitedById String?   @map("invited_by_id") @db.Uuid
  email       String
  role        Int       @default(5)
  token       String    @unique
  accepted    Boolean   @default(false)
  respondedAt DateTime? @map("responded_at")
  @@map("project_member_invites")
}

model ProjectUserProperty {
  id          String    @id @default(uuid()) @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String    @map("project_id") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String    @map("workspace_id") @db.Uuid
  user        User      @relation("ProjectUserPropsUser", fields: [userId], references: [id], onDelete: Cascade)
  userId      String    @map("user_id") @db.Uuid
  filters     Json      @default("{}")
  displayFilters Json   @default("{}") @map("display_filters")
  displayProperties Json @default("{}") @map("display_properties")
  @@unique([projectId, userId])
  @@map("project_user_properties")
}

model State {
  id          String    @id @default(uuid()) @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  createdById String?   @map("created_by_id") @db.Uuid
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String    @map("project_id") @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  name        String
  description String    @default("")
  color       String    @default("#ffffff")
  slug        String
  sequence    Float     @default(65535)
  group       String    @default("backlog")
  isTriage    Boolean   @default(false) @map("is_triage")
  default     Boolean   @default(false)
  externalSource String? @map("external_source")
  externalId  String?   @map("external_id")
  issues      Issue[]
  @@unique([projectId, name, deletedAt])
  @@map("states")
}

model Label {
  id          String    @id @default(uuid()) @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  createdById String?   @map("created_by_id") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String    @map("workspace_id") @db.Uuid
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String?   @map("project_id") @db.Uuid
  parent      Label?    @relation("LabelParent", fields: [parentId], references: [id])
  parentId    String?   @map("parent_id") @db.Uuid
  children    Label[]   @relation("LabelParent")
  name        String
  description String    @default("")
  color       String    @default("")
  sortOrder   Float     @default(65535) @map("sort_order")
  externalSource String? @map("external_source")
  externalId  String?   @map("external_id")
  issueLabels IssueLabel[]
  pageLabels  PageLabel[]
  @@map("labels")
}

model Issue {
  id                  String    @id @default(uuid()) @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")
  createdById         String?   @map("created_by_id") @db.Uuid
  updatedById         String?   @map("updated_by_id") @db.Uuid
  project             Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId           String    @map("project_id") @db.Uuid
  workspaceId         String    @map("workspace_id") @db.Uuid
  parent              Issue?    @relation("IssueParent", fields: [parentId], references: [id])
  parentId            String?   @map("parent_id") @db.Uuid
  children            Issue[]   @relation("IssueParent")
  state               State?    @relation(fields: [stateId], references: [id], onDelete: SetNull)
  stateId             String?   @map("state_id") @db.Uuid
  entity              Entity?   @relation(fields: [entityId], references: [id], onDelete: SetNull)
  entityId            String?   @map("entity_id") @db.Uuid
  createdBy           User?     @relation("IssueCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy           User?     @relation("IssueUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  name                String
  descriptionJson     Json?     @map("description_json")
  descriptionHtml     String    @default("<p></p>") @map("description_html")
  descriptionStripped String    @default("") @map("description_stripped")
  priority            String    @default("none")
  sortOrder           Float     @default(65535) @map("sort_order")
  completedAt         DateTime? @map("completed_at")
  archivedAt          DateTime? @map("archived_at")
  isDraft             Boolean   @default(false) @map("is_draft")
  sequenceId          Int       @default(0) @map("sequence_id")
  startDate           DateTime? @map("start_date")
  targetDate          DateTime? @map("target_date")
  point               Int?
  externalSource      String?   @map("external_source")
  externalId          String?   @map("external_id")
  legacyTicketNumber  String?   @map("legacy_ticket_number") @db.VarChar(50)
  assignees     IssueAssignee[]
  labels        IssueLabel[]
  comments      IssueComment[]
  activities    IssueActivity[]
  attachments   IssueAttachment[]
  links         IssueLink[]
  relationsFrom IssueRelation[]       @relation("IssueRelationFrom")
  relationsTo   IssueRelation[]       @relation("IssueRelationTo")
  cycleIssues   CycleIssue[]
  moduleIssues  ModuleIssue[]
  visitLinks    TechnicalVisitIssue[]
  reactions     IssueReaction[]
  subscribers   IssueSubscriber[]
  votes         IssueVote[]
  mentions      IssueMention[]
  blockers      IssueBlocker[]        @relation("IssueBlockerIssue")
  blockedBy     IssueBlocker[]        @relation("IssueBlockedBy")
  intakeIssues  IntakeIssue[]
  timeLogs      IssueTimeLog[]
  versions      IssueVersion[]
  gitLinks      GitIssueLink[]
  @@index([legacyTicketNumber])
  @@map("issues")
}

model IssueAssignee {
  id          String    @id @default(uuid()) @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  issue       Issue     @relation(fields: [issueId], references: [id], onDelete: Cascade)
  issueId     String    @map("issue_id") @db.Uuid
  assignee    User      @relation(fields: [assigneeId], references: [id], onDelete: Cascade)
  assigneeId  String    @map("assignee_id") @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  @@unique([issueId, assigneeId, deletedAt])
  @@map("issue_assignees")
}

model IssueLabel {
  id          String    @id @default(uuid()) @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  issue       Issue     @relation(fields: [issueId], references: [id], onDelete: Cascade)
  issueId     String    @map("issue_id") @db.Uuid
  label       Label     @relation(fields: [labelId], references: [id], onDelete: Cascade)
  labelId     String    @map("label_id") @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  @@unique([issueId, labelId, deletedAt])
  @@map("issue_labels")
}

model IssueComment {
  id             String    @id @default(uuid()) @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")
  createdById    String?   @map("created_by_id") @db.Uuid
  updatedById    String?   @map("updated_by_id") @db.Uuid
  issue          Issue     @relation(fields: [issueId], references: [id], onDelete: Cascade)
  issueId        String    @map("issue_id") @db.Uuid
  actor          User?     @relation("CommentActor", fields: [actorId], references: [id], onDelete: Cascade)
  actorId        String?   @map("actor_id") @db.Uuid
  workspaceId    String    @map("workspace_id") @db.Uuid
  projectId      String    @map("project_id") @db.Uuid
  parent         IssueComment?  @relation("CommentParent", fields: [parentId], references: [id])
  parentId       String?   @map("parent_id") @db.Uuid
  children       IssueComment[] @relation("CommentParent")
  commentJson    Json?     @map("comment_json")
  commentHtml    String    @default("<p></p>") @map("comment_html")
  commentStripped String   @default("") @map("comment_stripped")
  access         String    @default("INTERNAL")
  editedAt       DateTime? @map("edited_at")
  externalSource String?   @map("external_source")
  externalId     String?   @map("external_id")
  reactions      CommentReaction[]
  @@map("issue_comments")
}

model IssueReaction {
  id          String    @id @default(uuid()) @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  issue       Issue     @relation(fields: [issueId], references: [id], onDelete: Cascade)
  issueId     String    @map("issue_id") @db.Uuid
  actor       User      @relation("IssueReactionActor", fields: [actorId], references: [id], onDelete: Cascade)
  actorId     String    @map("actor_id") @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  reaction    String
  @@unique([issueId, actorId, reaction, deletedAt])
  @@map("issue_reactions")
}

model CommentReaction {
  id          String    @id @default(uuid()) @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  comment     IssueComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commentId   String    @map("comment_id") @db.Uuid
  actor       User      @relation("CommentReactionActor", fields: [actorId], references: [id], onDelete: Cascade)
  actorId     String    @map("actor_id") @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  reaction    String
  @@unique([commentId, actorId, reaction, deletedAt])
  @@map("comment_reactions")
}

model IssueSubscriber {
  id           String    @id @default(uuid()) @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")
  issue        Issue     @relation(fields: [issueId], references: [id], onDelete: Cascade)
  issueId      String    @map("issue_id") @db.Uuid
  subscriber   User      @relation("IssueSubscriberUser", fields: [subscriberId], references: [id], onDelete: Cascade)
  subscriberId String    @map("subscriber_id") @db.Uuid
  workspaceId  String    @map("workspace_id") @db.Uuid
  projectId    String    @map("project_id") @db.Uuid
  @@unique([issueId, subscriberId, deletedAt])
  @@map("issue_subscribers")
}

model IssueVote {
  id          String    @id @default(uuid()) @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  issue       Issue     @relation(fields: [issueId], references: [id], onDelete: Cascade)
  issueId     String    @map("issue_id") @db.Uuid
  actor       User      @relation("IssueVoteActor", fields: [actorId], references: [id], onDelete: Cascade)
  actorId     String    @map("actor_id") @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  vote        Int       @default(1)
  @@unique([issueId, actorId, deletedAt])
  @@map("issue_votes")
}

model IssueMention {
  id          String    @id @default(uuid()) @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  issue       Issue     @relation(fields: [issueId], references: [id], onDelete: Cascade)
  issueId     String    @map("issue_id") @db.Uuid
  mention     User      @relation("IssueMentionUser", fields: [mentionId], references: [id], onDelete: Cascade)
  mentionId   String    @map("mention_id") @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  @@unique([issueId, mentionId, deletedAt])
  @@map("issue_mentions")
}

model IssueBlocker {
  id          String    @id @default(uuid()) @db.Uuid
