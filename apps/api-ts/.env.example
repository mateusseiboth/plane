DATABASE_URL=postgresql://plane:plane@localhost:5432/plane
PORT=8001
NODE_ENV=development

# Segredo da ponte plataforma <-> backend dos plugins (HMAC). Obrigatório para o
# proxy /api/v1/plugin-sdk/backend/*: sem ele o proxy responde 503.
# Gere com: openssl rand -hex 32
PLUGIN_BRIDGE_SECRET=

# Segredo das rotas internas /api/internal/chat/* (robô do chat: ouvidoria,
# currículo, e-mail do responsável). Vazio = rotas desligadas (503). O mesmo
# valor vai no chat-backend. Gere com: openssl rand -hex 32
CHAT_SERVICE_TOKEN=

# Fuso usado para gravar o DIA da denúncia interna (sem hora, de propósito).
TZ_PADRAO=America/Campo_Grande

# IA da Quality: busca na wiki da Quality e a IA que responde com ela (bloco
# "Na wiki" do modal de solicitação). Fora do ar, o bloco fica vazio.
IA_DA_QUALITY_URL=https://ia.qualitysistemas.inf.br
# Endereço público da wiki, para os links das páginas sugeridas.
WIKI_DA_QUALITY_URL=https://wiki.qualitysistemas.inf.br
# Teto da busca (enquanto a pessoa digita) e da resposta da IA (no clique).
IA_DA_QUALITY_TIMEOUT_MS=6000
IA_DA_QUALITY_RESPOSTA_TIMEOUT_MS=30000
