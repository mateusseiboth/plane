// Chat backend schema. Decoupled from the Plane schema: it references Plane
// userId / workspaceId as plain strings (no FK) so it can run against its own
// database. All tables are prefixed chat_* so sharing the Plane Postgres is safe.

// O client é gerado dentro do próprio app: sem isso, `prisma generate` do api-ts
// e do chat-backend sobrescrevem o MESMO pacote @prisma/client (pnpm workspace
// com store compartilhado) e um passa a enxergar os models do outro.
//
// Fica FORA de src/ de propósito: o compose monta `./src:/app/src` para hot
// reload, e esse mount esconderia o client gerado dentro da imagem — o container
// subia com "Cannot find module '@/generated/prisma'".
generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Contacts ────────────────────────────────────────────────────────────────
model Contact {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @map("workspace_id")
  name        String?
  phone       String? // E.164 for WhatsApp contacts
  email       String?
  entityId  String?  @map("entity_id") @db.Uuid
  extra       Json          @default("{}")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  sessions    ChatSession[]

  @@unique([workspaceId, phone])
  @@index([workspaceId])
  @@map("chat_contacts")
}

// ── Sessions / messages ───────────────────────────────────────────────────────
model ChatSession {
  id                 String        @id @default(uuid()) @db.Uuid
  protocol           String        @unique
  channel            String // "whatsapp" | "native"
  workspaceId        String        @map("workspace_id")
  contactId          String?       @map("contact_id") @db.Uuid
  contact            Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  // Responsável (`entity_contacts`) identificado pelo telefone no início da
  // conversa ou cadastrado no encerramento. Sem FK e sem relation: a tabela é
  // da API principal e este schema não é dono dela — ver src/responsaveis.ts.
  entityContactId    String?       @map("entity_contact_id") @db.Uuid
  clientBrowserId    String?       @map("client_browser_id")
  clientName         String?       @map("client_name")
  clientPhone        String?       @map("client_phone")
  status             String        @default("bot") // "bot" | "queued" | "active" | "closed"
  queueId            String?       @map("queue_id") @db.Uuid
  assignedAttendantId String?      @map("assigned_attendant_id")
  // Native widget: the "system" (Plane project) the client needs help with, and an
  // optional attendant the client asked for directly (route-to if available).
  projectId          String?       @map("project_id") @db.Uuid
  projectIdentifier  String?       @map("project_identifier")
  projectName        String?       @map("project_name")
  requestedAttendantId String?     @map("requested_attendant_id")
  currentFlowId      String?       @map("current_flow_id") @db.Uuid
  flowState          Json          @default("{}") @map("flow_state")
  botState           String        @default("new") @map("bot_state") // new | awaiting_name | confirm_contact | menu | in_flow | done
  lastClientMessageAt DateTime?    @map("last_client_message_at")
  lastAttendantMessageAt DateTime? @map("last_attendant_message_at")
  // Read receipts: how far the native client has read (blue double-check).
  clientLastReadAt   DateTime?     @map("client_last_read_at")
  idlePromptedAt     DateTime?     @map("idle_prompted_at")
  // Post-service satisfaction survey (1..5 + free comment).
  ratingScore        Int?          @map("rating_score")
  ratingComment      String?       @map("rating_comment")
  ratingState        String?       @map("rating_state") // null | awaiting_score | awaiting_comment | done
  ratingRequestedAt  DateTime?     @map("rating_requested_at")
  createdAt          DateTime      @default(now()) @map("created_at")
  closedAt           DateTime?     @map("closed_at")
  closedById         String?       @map("closed_by_id")
  // Origem no chat antigo (SAC): `chat.chat_id`. Só é preenchido pela migração
  // scripts/migrate-sac-chat.ts e é o que a torna idempotente.
  legacyId           Int?          @unique @map("legacy_id")
  // ── Ciclo de vida (0013_ciclo_de_vida.sql) ──
  // Entidade (o cliente) do atendimento. Obrigatória para o atendente encerrar.
  // Sem FK: `entities` é da API principal (ver src/responsaveis.ts).
  entityId           String?       @map("entity_id") @db.Uuid
  // Classificação do encerramento: tipo do motivo (rótulo do catálogo em
  // BotConfig.closeReasons, gravado como texto para o histórico não mudar
  // quando o catálogo mudar), funcionalidade (módulo do sistema) e observação.
  closeReason        String?       @map("close_reason")
  closeModuleId      String?       @map("close_module_id") @db.Uuid
  closeModuleName    String?       @map("close_module_name")
  closeNote          String?       @map("close_note")
  // Como terminou: atendente | cliente | inatividade | fim_do_dia | robo | abandono
  // (abandono = histórico do SAC sem o tipo gravado).
  endKind            String?       @map("end_kind")
  // Tipo de abandono 1..5 do SAC (ver src/ciclo-de-vida/abandono.ts). Nulo = finalizado.
  abandonType        Int?          @map("abandon_type") @db.SmallInt
  // Chat do site em pausa: o cliente pode voltar em até 3 dias.
  pausedAt           DateTime?     @map("paused_at")
  // Chamado aberto a partir desta conversa (issues.external_id = id da sessão).
  issueId            String?       @map("issue_id") @db.Uuid
  issueProjectId     String?       @map("issue_project_id") @db.Uuid
  issueLabel         String?       @map("issue_label")
  // ── Ferramentas do atendente (0014_atendente.sql) ──
  // Alerta de cliente sem resposta pausado pelo atendente; vence em 40 min
  // (src/atendente/alerta.ts).
  slaAlertPausedAt   DateTime?     @map("sla_alert_paused_at")
  // Dados técnicos mandados pelo sistema que embute o widget (versão,
  // computador, navegador, SO, resolução, motivo). Ver src/atendente/client-info.ts.
  clientInfo         Json          @default("{}") @map("client_info")
  messages           ChatMessage[]
  readStates         ChatReadState[]
  ligacao            ChatLigacao?

  @@index([workspaceId, status])
  @@index([workspaceId, channel])
  @@index([assignedAttendantId])
  @@index([clientBrowserId])
  @@index([clientPhone])
  @@index([entityContactId])
  @@index([workspaceId, closedAt])
  @@index([entityId])
  @@index([issueId])
  @@index([workspaceId, createdAt])
  @@map("chat_sessions")
}

model ChatMessage {
  id           String      @id @default(uuid()) @db.Uuid
  sessionId    String      @map("session_id") @db.Uuid
  session      ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sender       String // "client" | "bot" | "attendant" | "system"
  senderUserId String?     @map("sender_user_id")
  senderName   String?     @map("sender_name")
  type         String      @default("text") // text | image | video | audio | file | event
  text         String?
  mediaKey     String?     @map("media_key")
  mediaMime    String?     @map("media_mime")
  mediaName    String?     @map("media_name")
  replyToId    String?     @map("reply_to_id") @db.Uuid
  editedAt     DateTime?   @map("edited_at")
  // Prior versions of the text, oldest→newest: [{ text, edited_at }]. Staff-only.
  editHistory  Json        @default("[]") @map("edit_history")
  deletedAt    DateTime?   @map("deleted_at")
  externalId   String?     @map("external_id") // provider message id (dedup)
  status       String      @default("sent") // sent | delivered | read | failed
  // Motivo da falha de envio ao WhatsApp (status = failed). O atendente reenvia.
  sendError    String?     @map("send_error")
  // "Enviar sem o nome": sem o `*Nome*:` no WhatsApp e sem o rótulo no widget.
  withoutSenderName Boolean  @default(false) @map("without_sender_name")
  createdAt    DateTime    @default(now()) @map("created_at")
  // Origem no chat antigo (SAC): `chat_mensagens.chat_mensagens_id`.
  legacyId     Int?        @unique @map("legacy_id")

  @@index([sessionId, createdAt])
  @@index([externalId])
  @@map("chat_messages")
}

model ChatReadState {
  id                String      @id @default(uuid()) @db.Uuid
  sessionId         String      @map("session_id") @db.Uuid
  session           ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId            String      @map("user_id")
  lastReadMessageId String?     @map("last_read_message_id")
  lastReadAt        DateTime    @default(now()) @map("last_read_at")

  @@unique([sessionId, userId])
  @@map("chat_read_states")
}

// ── Queues / routing ──────────────────────────────────────────────────────────
model Queue {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @map("workspace_id")
  name        String
  isActive    Boolean       @default(true) @map("is_active")
  createdAt   DateTime      @default(now()) @map("created_at")
  members     QueueMember[]

  @@index([workspaceId])
  @@map("chat_queues")
}

model QueueMember {
  id      String @id @default(uuid()) @db.Uuid
  queueId String @map("queue_id") @db.Uuid
  queue   Queue  @relation(fields: [queueId], references: [id], onDelete: Cascade)
  userId  String @map("user_id")

  @@unique([queueId, userId])
  @@map("chat_queue_members")
}

// ── Attendant schedules / breaks ──────────────────────────────────────────────
model AttendantSchedule {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @map("workspace_id")
  userId      String @map("user_id")
  weekday     Int // 0=Sun .. 6=Sat
  startTime   String @map("start_time") // "HH:MM"
  endTime     String @map("end_time")

  @@index([workspaceId, userId])
  @@map("chat_attendant_schedules")
}

model AttendantBreak {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @map("workspace_id")
  userId      String @map("user_id")
  weekday     Int
  startTime   String @map("start_time")
  endTime     String @map("end_time")

  @@index([workspaceId, userId])
  @@map("chat_attendant_breaks")
}

// Per-attendant runtime status. isInvisible (set by an admin) keeps an online
// attendant from receiving routed chats while still connected.
model AttendantStatus {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id")
  userId      String   @map("user_id")
  isInvisible Boolean  @default(false) @map("is_invisible")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([workspaceId, userId])
  @@map("chat_attendant_status")
}

// ── Bot configuration / flows ─────────────────────────────────────────────────
model BotConfig {
  workspaceId          String   @id @map("workspace_id")
  welcomeMessage       String   @default("Olá! Bem-vindo ao atendimento.") @map("welcome_message")
  menuHeader           String   @default("Escolha uma opção:") @map("menu_header")
  noAttendantsMessage  String   @default("No momento não há atendentes disponíveis. Assim que possível retornaremos.") @map("no_attendants_message")
  askNameMessage       String   @default("Para começarmos, qual é o seu nome?") @map("ask_name_message")
  confirmContactMessage String  @default("Você é {name}?") @map("confirm_contact_message")
  idlePromptMessage    String   @default("Você ainda precisa de ajuda?") @map("idle_prompt_message")
  idleCloseMessage     String   @default("Atendimento encerrado por inatividade. Protocolo: {protocol}") @map("idle_close_message")
  closedMessage        String   @default("Atendimento encerrado. Protocolo: {protocol}") @map("closed_message")
  assumedMessage       String   @default("{attendant} entrou no atendimento e vai te ajudar a partir de agora.") @map("assumed_message")
  outsideHoursMessage  String   @default("Estamos fora do horário de atendimento no momento. Retornaremos assim que possível.") @map("outside_hours_message")
  // Company-wide business hours / breaks (not per-attendant):
  //   businessHours: [{ weekday: 0-6, start: "HH:MM", end: "HH:MM" }]
  businessHours        Json     @default("[]") @map("business_hours")
  businessBreaks       Json     @default("[]") @map("business_breaks")
  // Catálogo do tipo de motivo do encerramento: [{ key, label }].
  closeReasons         Json     @default("[{\"key\":\"acesso\",\"label\":\"Acesso\"},{\"key\":\"duvida\",\"label\":\"Dúvida\"},{\"key\":\"correcao\",\"label\":\"Correção\"},{\"key\":\"melhoria\",\"label\":\"Melhoria\"},{\"key\":\"senha\",\"label\":\"Senha\"}]") @map("close_reasons")
  // Pergunta ao cliente que ficou 10 min sem responder o atendente.
  activeIdlePromptMessage String @default("Você não responde há mais de 10 minutos. Digite *1* para continuar o atendimento ou *99* para encerrar.") @map("active_idle_prompt_message")
  // Fim do dia: encerra as conversas de WhatsApp abertas no horário informado.
  endOfDayEnabled      Boolean  @default(false) @map("end_of_day_enabled")
  endOfDayTime         String?  @map("end_of_day_time") // "HH:MM"; vazio = fim do expediente do dia
  endOfDayMessage      String   @default("Agradecemos seu contato. O atendimento foi encerrado e estamos à disposição sempre que precisar.") @map("end_of_day_message")
  // Feriados: fora do horário o dia inteiro. [{ date: "AAAA-MM-DD", label, recorrente }]
  holidays             Json     @default("[]")
  routingAlpha         Float    @default(1) @map("routing_alpha") // weight of active chats
  routingBeta          Float    @default(0.5) @map("routing_beta") // weight of today's count
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("chat_bot_config")
}

model BotMenuOption {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id")
  order       Int      @default(0)
  key         String // "1", "2", ...
  label       String
  action      String // "queue" | "flow" | "message"
  queueId     String?  @map("queue_id") @db.Uuid
  flowId      String?  @map("flow_id") @db.Uuid
  message     String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([workspaceId])
  @@map("chat_bot_menu_options")
}

model BotFlow {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id")
  name        String
  isActive    Boolean  @default(true) @map("is_active")
  // steps: [{ type: "message"|"ask"|"queue"|"close", text?, saveAs?, queueId? }, ...]
  steps       Json     @default("[]")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([workspaceId])
  @@map("chat_bot_flows")
}

// ── WhatsApp provider config (per workspace) ──────────────────────────────────
model ProviderConfig {
  workspaceId  String   @id @map("workspace_id")
  provider     String   @default("zapi") // zapi | meta | ...
  instanceId   String?  @map("instance_id")
  token        String?
  clientToken  String?  @map("client_token")
  // Token que a Z-API manda no webhook (cabeçalho Client-Token ou ?token=).
  // Só é exigido quando configurado.
  webhookToken String?  @map("webhook_token")
  baseUrl      String?  @map("base_url")
  isActive     Boolean  @default(false) @map("is_active")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("chat_provider_config")
}

// Frases prontas do atendente, por espaço (src/atendente/frases.ts).
model ChatFrasePronta {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id")
  texto       String
  ordem       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([workspaceId, ordem])
  @@map("chat_frases_prontas")
}

// Daily counter used both for protocol numbering and routing stats.
model ProtocolCounter {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @map("workspace_id")
  day         String // "YYYYMMDD"
  seq         Int    @default(0)

  @@unique([workspaceId, day])
  @@map("chat_protocol_counters")
}

// ── Ligações (FreePBX) ────────────────────────────────────────────────────────
// A ligação é uma ChatSession com channel = "phone"; aqui fica o que é só dela:
// os dados do PBX e o que o atendente registrou ao concluir. Ver
// .claude/ligacoes-freepbx.md.
model ChatLigacao {
  id              String      @id @default(uuid()) @db.Uuid
  sessionId       String      @unique @map("session_id") @db.Uuid
  session         ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  workspaceId     String      @map("workspace_id")
  // Identificador da chamada no PBX (uniqueid/linkedid do CDR). Torna o envio idempotente.
  callId          String      @map("call_id")
  caller          String?
  extension       String?
  status          String      @default("answered") // answered | missed
  startedAt       DateTime?   @map("started_at")
  endedAt         DateTime?   @map("ended_at")
  durationSec     Int?        @map("duration_sec")
  recordingUrl    String?     @map("recording_url")
  descricao       String?
  concludedById   String?     @map("concluded_by_id")
  concludedAt     DateTime?   @map("concluded_at")
  // Chamado aberto a partir da ligação (issue ou solicitação do api-ts). Sem FK:
  // a tabela é da API principal.
  ticketKind      String?     @map("ticket_kind") // issue | intake
  ticketId        String?     @map("ticket_id") @db.Uuid
  ticketProjectId String?     @map("ticket_project_id") @db.Uuid
  ticketLabel     String?     @map("ticket_label")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  @@unique([workspaceId, callId])
  @@index([workspaceId, createdAt])
  @@map("chat_ligacoes")
}

// Token de serviço do PBX por espaço: só o hash e os 4 últimos caracteres.
model ChatTelefoniaConfig {
  workspaceId String   @id @map("workspace_id")
  tokenHash   String?  @map("token_hash")
  tokenLast4  String?  @map("token_last4")
  updatedById String?  @map("updated_by_id")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("chat_telefonia_config")
}

// Ramal do PBX → atendente (usuário do Plane).
model ChatRamal {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id")
  extension   String
  userId      String   @map("user_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([workspaceId, extension])
  @@map("chat_ramais")
}

// ── Disparo em massa (src/disparo/, migration 0016) ──────────────────────────
// Só quem tem `chat.disparo`. A mensagem é o cadastro; cada envio é uma
// execução com a cópia do texto e do arquivo daquele momento, e um item por
// telefone (sem repetir número) que o worker processa no ritmo configurado.

model ChatDisparoMensagem {
  id          String                @id @default(uuid()) @db.Uuid
  workspaceId String                @map("workspace_id")
  titulo      String
  texto       String?
  mediaKey    String?               @map("media_key")
  mediaMime   String?               @map("media_mime")
  mediaName   String?               @map("media_name")
  createdById String                @map("created_by_id")
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")
  deletedAt   DateTime?             @map("deleted_at")
  execucoes   ChatDisparoExecucao[]

  @@index([workspaceId, deletedAt])
  @@map("chat_disparo_mensagens")
}

model ChatDisparoExecucao {
  id          String              @id @default(uuid()) @db.Uuid
  workspaceId String              @map("workspace_id")
  mensagemId  String              @map("mensagem_id") @db.Uuid
  mensagem    ChatDisparoMensagem @relation(fields: [mensagemId], references: [id], onDelete: Cascade)
  titulo      String
  texto       String?
  mediaKey    String?             @map("media_key")
  mediaMime   String?             @map("media_mime")
  mediaName   String?             @map("media_name")
  // {entity_type, entity_id, project_id} como foram escolhidos na tela.
  filtros     Json                @default("{}")
  total       Int                 @default(0)
  semTelefone Int                 @default(0) @map("sem_telefone")
  repetidos   Int                 @default(0)
  status      String              @default("em_andamento") // em_andamento | concluida | cancelada
  createdById String              @map("created_by_id")
  createdAt   DateTime            @default(now()) @map("created_at")
  finishedAt  DateTime?           @map("finished_at")
  itens       ChatDisparoItem[]

  @@index([workspaceId, createdAt])
  @@index([status])
  @@map("chat_disparo_execucoes")
}

model ChatDisparoItem {
  id          String              @id @default(uuid()) @db.Uuid
  execucaoId  String              @map("execucao_id") @db.Uuid
  execucao    ChatDisparoExecucao @relation(fields: [execucaoId], references: [id], onDelete: Cascade)
  workspaceId String              @map("workspace_id")
  telefone    String
  contactId   String?             @map("contact_id")
  contactName String?             @map("contact_name")
  entityName  String?             @map("entity_name")
  status      String              @default("pendente") // pendente | processando | enviado | falhou | cancelado
  erro        String?
  externalId  String?             @map("external_id")
  tentadoEm   DateTime?           @map("tentado_em")
  createdAt   DateTime            @default(now()) @map("created_at")

  @@unique([execucaoId, telefone])
  @@index([workspaceId, status])
  @@index([workspaceId, tentadoEm])
  @@map("chat_disparo_itens")
}

model ChatDisparoConfig {
  workspaceId        String   @id @map("workspace_id")
  mensagensPorMinuto Int      @default(20) @map("mensagens_por_minuto")
  updatedById        String?  @map("updated_by_id")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("chat_disparo_config")
}
