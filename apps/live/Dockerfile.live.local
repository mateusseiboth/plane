# Igual a web e admin: NADA é construído aqui dentro, só copiado. Antes de
# `docker compose build live` é preciso, na raiz do repositório:
#
#   pnpm turbo run build --filter=live          # gera apps/live/dist
#   pnpm --filter live deploy --legacy --prod apps/live/.deploy
#   pnpm install   # o passo acima PODA o node_modules do workspace inteiro
#
# O segundo passo existe porque o `dist` do live NÃO embute as dependências
# (`express`, `@hocuspocus/*`, `@plane/editor`…): elas continuam sendo imports.
# O `node_modules` do pnpm é uma teia de symlinks para fora do contexto de
# build, e o COPY do Docker não sabe segui-los — `pnpm deploy` materializa
# essa árvore num diretório de verdade.
FROM node:22-bookworm-slim
WORKDIR /app

# Debian, e não Alpine: o `sharp` e os demais binários nativos vêm resolvidos
# pelo host (Debian, glibc). Num Alpine (musl) o processo morre já no import.
COPY .deploy/node_modules ./node_modules
COPY .deploy/package.json ./package.json
COPY dist ./dist

EXPOSE 3100
ENV NODE_ENV=production
CMD ["node", "dist/start.mjs"]
