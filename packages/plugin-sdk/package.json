{
  "name": "@mateusseiboth/plugins-aviao",
  "version": "1.0.0",
  "description": "Official SDK for the Avião Plugin system (sidebar items, full pages, data APIs)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mateusseiboth/plane.git",
    "directory": "packages/plugin-sdk"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "src/index.ts",
  "publishConfig": {
    "@mateusseiboth:registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly --outDir dist",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.8.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.0.0"
  }
}
