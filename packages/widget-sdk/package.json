{
  "name": "@mateusseiboth/widgets-aviao",
  "version": "1.0.0",
  "description": "SDK oficial dos widgets da página inicial do Avião: hooks React, APIs de dados e o contrato com a plataforma.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mateusseiboth/plane.git",
    "directory": "packages/widget-sdk"
  },
  "files": [
    "dist",
    "referencia.json",
    "README.md"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./src/index.ts"
    },
    "./referencia.json": "./referencia.json",
    "./referencia-tipos": {
      "types": "./scripts/referencia-tipos.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.mjs",
        "require": "./dist/index.cjs"
      },
      "./referencia.json": "./referencia.json"
    },
    "types": "dist/index.d.ts"
  },
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly --outDir dist && node scripts/gerar-referencia.ts && node scripts/empacotar.ts",
    "dev": "vite build --watch",
    "referencia": "node scripts/gerar-referencia.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.8.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.0.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
